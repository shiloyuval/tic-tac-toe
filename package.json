{
  "name": "tic-tac-toe",
  "version": "1.0.0",
  "private": true,
  "description": "Tic-Tac-Toe game written in TypeScript, playable in the console or in the browser",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "play": "tsx src/index.ts",
    "dev:web": "vite",
    "dev:web:api": "vite --mode api",
    "build:web": "vite build",
    "build:web:api": "vite build --mode api",
    "preview:web": "vite preview",
    "server": "tsx src/server/index.ts",
    "start:web": "vite build --mode api && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
